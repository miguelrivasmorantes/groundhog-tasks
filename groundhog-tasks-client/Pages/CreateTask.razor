@page "/tasks/create"
@using groundhog_tasks_client.DTOs
@using Blazored.LocalStorage
@using System.Net.Http.Json
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation

<div class="container mt-4 mb-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">✨ Nueva Tarea</h3>
        </div>
        <div class="card-body">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="@taskModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-6">
                        <h5 class="text-primary mb-3">1. Detalles</h5>

                        <div class="mb-3">
                            <label class="form-label">Título de la Tarea</label>
                            <input class="form-control" @bind="taskModel.Name" required placeholder="Ej: Revisar documentación" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" @bind="taskModel.Description" rows="3"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Fecha de Inicio</label>
                            <input type="datetime-local" class="form-control" @bind="taskModel.StartDate" />
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Frecuencia</label>
                                <select class="form-select" @bind="taskModel.Periodicity">
                                    <option value="00:00:00">Una sola vez</option>
                                    <option value="24:00:00">Diario (24h)</option>
                                    <option value="168:00:00">Semanal</option>
                                    <option value="720:00:00">Mensual (30 días)</option>
                                </select>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Ciclos</label>
                                <input type="number" class="form-control" @bind="taskModel.Cycles" min="1" />
                                <small class="text-muted" style="font-size: 0.75rem">Veces que se repite</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h5 class="text-primary mb-3">2. Asignación</h5>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Selecciona el Grupo</label>
                            <select class="form-select" @onchange="OnGroupChanged">
                                <option value="" selected disabled>-- Elige un grupo --</option>
                                @foreach (var group in myGroups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </select>
                            <small class="text-muted">Solo verás los grupos a los que perteneces.</small>
                        </div>

                        @if (isLoadingMembers)
                        {
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span>Cargando miembros...</span>
                        }
                        else if (groupMembers.Count > 0)
                        {
                            <div class="card bg-light border-0">
                                <div class="card-body">
                                    <label class="form-label fw-bold mb-2">Asignar a:</label>
                                    <div style="max-height: 200px; overflow-y: auto;">
                                        @foreach (var member in groupMembers)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox"
                                                       id="user_@member.Id"
                                                       @onchange="(e) => ToggleUserSelection(member.Id, e.Value)">
                                                <label class="form-check-label" for="user_@member.Id">
                                                    @member.FirstName @member.LastName
                                                </label>
                                            </div>
                                        }
                                    </div>
                                    <small class="text-muted mt-2 d-block">
                                        Seleccionados: @taskModel.UserIds.Count
                                    </small>
                                </div>
                            </div>
                        }
                        else if (taskModel.GroupId != Guid.Empty)
                        {
                            <div class="alert alert-warning mt-2">Este grupo no tiene otros miembros.</div>
                        }
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/my-tasks")'>Cancelar</button>
                    <button type="submit" class="btn btn-success px-4" disabled="@(taskModel.GroupId == Guid.Empty)">
                        Crear Tarea
                    </button>
                </div>

            </EditForm>
        </div>
    </div>
</div>

@code {
    private CreateAssignmentDto taskModel = new CreateAssignmentDto();
    private List<UserGroupDto> myGroups = new List<UserGroupDto>();
    private List<GroupMemberDto> groupMembers = new List<GroupMemberDto>();

    private string errorMessage = "";
    private bool isLoadingMembers = false;

    private class CreatedTaskResponse { public Guid Id { get; set; } }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await LocalStorage.GetItemAsync<UserData>("user");
            if (user != null)
            {
                taskModel.CreatorUserId = user.Id;
                var response = await Http.GetAsync($"api/Users/{user.Id}/groups");
                if (response.IsSuccessStatusCode)
                {
                    myGroups = await response.Content.ReadFromJsonAsync<List<UserGroupDto>>() ?? new List<UserGroupDto>();
                }
            }
        }
        catch (Exception ex) { errorMessage = $"Error inicial: {ex.Message}"; }
    }

    private async Task OnGroupChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid selectedGroupId))
        {
            taskModel.GroupId = selectedGroupId;
            taskModel.UserIds.Clear();
            groupMembers.Clear();
            isLoadingMembers = true;

            try
            {
                var response = await Http.GetAsync($"api/groups/{selectedGroupId}/users");
                if (response.IsSuccessStatusCode)
                {
                    groupMembers = await response.Content.ReadFromJsonAsync<List<GroupMemberDto>>() ?? new List<GroupMemberDto>();
                }
            }
            catch (Exception ex) { errorMessage = "Error al cargar miembros: " + ex.Message; }
            finally { isLoadingMembers = false; }
        }
    }

    private void ToggleUserSelection(Guid userId, object isChecked)
    {
        if ((bool)isChecked)
        {
            if (!taskModel.UserIds.Contains(userId)) taskModel.UserIds.Add(userId);
        }
        else
        {
            if (taskModel.UserIds.Contains(userId)) taskModel.UserIds.Remove(userId);
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = "";
        if (taskModel.GroupId == Guid.Empty) { errorMessage = "Debes seleccionar un grupo."; return; }

        try
        {
            var createResponse = await Http.PostAsJsonAsync("api/Assignments", taskModel);

            if (!createResponse.IsSuccessStatusCode)
            {
                var errorContent = await createResponse.Content.ReadAsStringAsync();
                errorMessage = $"Error al crear tarea: {errorContent}";
                return;
            }

            var createdTask = await createResponse.Content.ReadFromJsonAsync<CreatedTaskResponse>();

            if (createdTask != null && taskModel.UserIds.Count > 0)
            {
                var assignBody = new
                {
                    userIds = taskModel.UserIds,
                    status = "Pending"
                };

                var assignResponse = await Http.PostAsJsonAsync($"api/Assignments/{createdTask.Id}/assign-users", assignBody);

                if (!assignResponse.IsSuccessStatusCode)
                {
                    errorMessage = "Tarea creada, pero hubo un error al asignar los usuarios.";
                    return;
                }
            }

            Navigation.NavigateTo("/my-tasks");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión: {ex.Message}";
        }
    }
}